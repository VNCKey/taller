%%{init: {'theme': 'dark', 'themeVariables': { 'darkMode': true, 'background': '#0f172a'}}}%%
flowchart TD
    %% ===================================================
    %% ENFOQUE 1: COMPARATIVA ESTRUCTURAL (COMPILE VS RUN)
    %% ===================================================

    subgraph CT["COMPILE TIME (TIEMPO DE COMPILACIÓN - RUSTC)"]
        direction TB

        C1["Expansión de Macros (código generado)"]
        C2["Inferencia & Chequeo Estático de Tipos"]
        C3["Monomorfización (Genéricos a tipos concretos)"]
        C4["Borrow Checker (Ownership, Lifetimes y Mutabilidad)"]
        C5["Evaluación de Constantes (const fn en compilación)"]
        C6["Optimizaciones LLVM (-O3, Inlining, SIMD)"]

        C1 --> C2 --> C3 --> C4 --> C5 --> C6
    end

    %% Puente de entrega del binario
    CT ==>|"Genera Binario Nativo Autónomo (ELF / .EXE)"| RT

    subgraph RT["RUN TIME (TIEMPO DE EJECUCIÓN - HARDWARE / CPU)"]
        direction TB

        R1["Cero Garbage Collector (Sin pausas STW)"]
        R2["Cero Chequeo de Tipos (Todo resuelto)"]
        R3["Cero Borrow Checker (Verificado previamente)"]
        R4["Gestión RAII (drop automático e instantáneo)"]
        R5["Bounds Checking (Seguridad de índices de arrays)"]
        R6["Ejecución Directa en CPU a Máxima Velocidad"]

        R1 --- R2 --- R3 --- R4 --- R5 --- R6
    end

    classDef compileBox fill:#1e293b,stroke:#38bdf8,stroke-width:1.5px,color:#f8fafc;
    classDef runtimeBox fill:#1e293b,stroke:#34d399,stroke-width:1.5px,color:#f8fafc;

    class C1,C2,C3,C4,C5,C6 compileBox;
    class R1,R2,R3,R4,R5,R6 runtimeBox;

    style CT fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#93c5fd
    style RT fill:#0f172a,stroke:#34d399,stroke-width:2px,color:#6ee7b7
