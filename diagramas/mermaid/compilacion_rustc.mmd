%%{init: {'theme': 'dark', 'themeVariables': { 'darkMode': true, 'background': '#0f172a'}}}%%
flowchart TD
    %% ==========================================
    %% FILA 1: DE CÓDIGO A SEGURIDAD (IZQ -> DER)
    %% ==========================================
    subgraph F1["FASE DE ANÁLISIS Y SEGURIDAD"]
        direction LR

        SRC["Código (.rs)"]

        subgraph S2["Frontend (rustc)"]
            direction TB
            LEX["Analizador Léxico + Parser"]
            AST["AST (Árbol Sintáctico)"]
            HIR["HIR (Tipos & Macros)"]
            LEX --> AST --> HIR
        end

        subgraph S3["Middle-End"]
            direction TB
            MIR["MIR (Grafo de Control)"]
            BC{{"Borrow Checker"}}
            MIR --> BC
        end

        SRC --> S2
        S2 --> S3
    end

    %% Conexión entre Fila 1 y Fila 2 (De arriba hacia abajo)
    F1 ==>|Código 100% Seguro| F2

    %% ==========================================
    %% FILA 2: DE OPTIMIZACIÓN A EJECUTABLE (IZQ -> DER)
    %% ==========================================
    subgraph F2["FASE DE OPTIMIZACIÓN Y MÁQUINA"]
        direction LR

        subgraph S4["Backend (LLVM)"]
            direction TB
            LLVM["LLVM IR Universal"]
            OPT["Optimizador O3 (SIMD / Inlining)"]
            ASM["Código Máquina (x86_64 / ARM)"]
            LLVM --> OPT --> ASM
        end

        subgraph S5["Enlace & Salida"]
            direction TB
            LIB["libstd + Crates"]
            LINK["Linker (ld / lld)"]
            BIN(["<b>ELF / .EXE / WASM</b>"]):::target
            LIB --> LINK
            LINK --> BIN
        end

        S4 --> LINK
    end

    classDef target fill:#059669,stroke:#34d399,stroke-width:3px,color:#fff;
    classDef default fill:#1e293b,stroke:#3b82f6,color:#f8fafc;
    style F1 fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#93c5fd
    style F2 fill:#0f172a,stroke:#a855f7,stroke-width:2px,color:#d8b4fe
    style SRC fill:#1e1e38,stroke:#818cf8,stroke-width:2px,color:#c7d2fe
    style BC fill:#7c2d12,stroke:#f97316,stroke-width:2px,color:#ffedd5
