%%{init: {'theme': 'dark', 'themeVariables': { 'darkMode': true, 'background': '#0f172a'}}}%%
graph TD
    subgraph "EXTERIOR (Visitante)"
        B[Bruno / Cliente gRPC]
    end

    subgraph "API LAYER (La Puerta / El Portero)"
        S[UnitService.rs]
        A[Adapter.rs - Traductor]
    end

    subgraph "FLOWS (El Cerebro / El Gerente)"
        F[create_unit_flow.rs]
        L[Lógica: Generar Código U-XXXX]
    end

    subgraph "DOMAIN (El Corazón / El Plano)"
        D[Unit Entity / Structs]
        V[Validaciones de Negocio]
    end

    subgraph "EFFECTS / FX (El Sótano / La Bóveda)"
        DB[Database functions]
        SQL[(PostgreSQL)]
    end

    %% Flujo de la petición
    B -->|1. Request gRPC| S
    S -->|2. Extraer Contexto| A
    A -->|3. CreateUnitCommand| F
    F -->|4. Define forma| D
    F -->|5. Ejecuta Lógica| L
    F -->|6. Guardar Datos| DB
    DB -->|7. SQL INSERT| SQL
    
    %% Retorno de la respuesta
    SQL -.->|8. Datos Sucios| DB
    DB -.->|9. Unit Domain| F
    F -.->|10. Unit Domain| A
    A -.->|11. Limpieza de Metadata| S
    S -.->|12. Response Proto| B

    style D fill:#be185d,stroke:#f472b6,stroke-width:2px,color:#fff
    style F fill:#4338ca,stroke:#818cf8,stroke-width:2px,color:#fff
    style SQL fill:#047857,stroke:#34d399,stroke-width:2px,color:#fff
    style B fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#fff
    style S fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#fff
    style A fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#fff
    style L fill:#4338ca,stroke:#818cf8,stroke-width:2px,color:#fff
    style V fill:#be185d,stroke:#f472b6,stroke-width:2px,color:#fff
    style DB fill:#047857,stroke:#34d399,stroke-width:2px,color:#fff
