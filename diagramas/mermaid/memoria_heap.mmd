%%{init: {'theme': 'dark', 'themeVariables': { 'darkMode': true, 'background': '#0e121a'}}}%%
flowchart LR
    %% ===================================================
    %% ARQUITECTURA DE MEMORIA HEAP (STRING BUFFER)
    %% ===================================================

    subgraph STACK ["STACK (String Metadata - 24 Bytes)"]
        direction TB
        subgraph S_VAR ["texto: String = String::from('Rust')"]
            S_DIR["MEMORY ADDRESS: 0x7FFEE4B2A890"]:::dirStyle
            S_PTR["ptr: 0x55A8F210E400 (8 Bytes)"]:::ptrStyle
            S_LEN["len: 4 (8 Bytes - usize)"]:::sizeStyle
            S_CAP["cap: 4 (8 Bytes - usize)"]:::sizeStyle
        end
    end

    subgraph HEAP ["HEAP (Buffer Dinamico de Bytes)"]
        direction TB
        subgraph H_BUFFER ["Buffer UTF-8 en Heap (0x55A8F210E400)"]
            H_DIR["MEMORY ADDRESS: 0x55A8F210E400"]:::ptrStyle
            H_DATA["['R' (0x52), 'u' (0x75), 's' (0x73), 't' (0x74)]<br/>SIZE: 4 Bytes contiguos en RAM"]:::valStyle
        end
    end

    S_PTR ==>|"Puntero 64-bit (0x55A8F210E400)"| H_BUFFER

    classDef default fill:#141c2b,stroke:#2d3c5a,stroke-width:1.2px,color:#ffffff;
    classDef dirStyle fill:#080c12,stroke:#64c8ff,stroke-width:1.2px,color:#64c8ff;
    classDef ptrStyle fill:#26180a,stroke:#ffa032,stroke-width:1.5px,color:#ffa032;
    classDef sizeStyle fill:#080c12,stroke:#456090,stroke-width:1.2px,color:#ffffff;
    classDef valStyle fill:#080c12,stroke:#38bdf8,stroke-width:1.2px,color:#64c8ff;
