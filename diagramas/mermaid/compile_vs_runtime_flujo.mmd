%%{init: {'theme': 'dark', 'themeVariables': { 'darkMode': true, 'background': '#0f172a'}}}%%
flowchart LR
    %% ===================================================
    %% ENFOQUE 2: FLUJO DE CICLO DE VIDA COMPILACIÓN -> EJECUCIÓN
    %% ===================================================

    subgraph ETAPA1["1. ETAPA DE COMPILACIÓN (Máquina del Desarrollador)"]
        direction TB

        SRC["Código Fuente (.rs)"]
        CHECK["Verificación Estricta<br/>(Tipos + Borrow Checker)"]
        OPT["Compilación & Optimización LLVM<br/>(Monoforfismo + Inlining)"]
        BIN(["Binario Final<br/><b>ELF / .EXE</b>"]):::binNode

        SRC --> CHECK --> OPT --> BIN
    end

    ETAPA1 ==>|"Despliegue / Distribución"| ETAPA2

    subgraph ETAPA2["2. ETAPA DE EJECUCIÓN (Máquina del Usuario / Servidor)"]
        direction TB

        LOAD["Carga en Memoria RAM<br/>(Segmento de Código / Stack)"]
        EXEC["Instrucciones en CPU<br/>(Sin intermediarios / Sin VM)"]
        MEM["Asignación Determinista<br/>(Heap según demanda)"]
        DROP["Liberación Automática (RAII)<br/>(drop al salir del scope)"]

        LOAD --> EXEC --> MEM --> DROP
    end

    classDef binNode fill:#059669,stroke:#34d399,stroke-width:2.5px,color:#ffffff;
    classDef default fill:#1e293b,stroke:#3b82f6,color:#f8fafc;

    style ETAPA1 fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#93c5fd
    style ETAPA2 fill:#0f172a,stroke:#a855f7,stroke-width:2px,color:#d8b4fe
    style SRC fill:#1e1e38,stroke:#818cf8,stroke-width:1.5px,color:#c7d2fe
