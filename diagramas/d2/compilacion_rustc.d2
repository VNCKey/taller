direction: down

title: "Pipeline de Compilación rustc y Extensiones de Archivo" {
  style: {
    font-size: 20
    bold: true
    font-color: "#ffffff"
  }
}

# --- FILA 1: ANÁLISIS Y SEGURIDAD ---
fila_1: "1. FASE DE ANÁLISIS Y SEGURIDAD (rustc)" {
  direction: right
  style: {
    fill: "#0f172a"
    stroke: "#38bdf8"
    stroke-width: 2
    border-radius: 8
  }

  origen: "Código Fuente\n[.rs]" {
    style: { fill: "#1e1e38"; stroke: "#818cf8"; font-color: "#c7d2fe"; bold: true }
  }

  frontend: "Frontend (rustc)\nAST -> HIR [.hir]" {
    style: { fill: "#1e293b"; stroke: "#38bdf8"; font-color: "#ffffff" }
  }

  middle: "Middle-End\nMIR [.mir] + Borrow Checker" {
    style: { fill: "#451a03"; stroke: "#ea580c"; font-color: "#ffedd5"; bold: true }
  }

  origen -> frontend -> middle
}

# --- FILA 2: OPTIMIZACIÓN Y MÁQUINA ---
fila_2: "2. FASE DE OPTIMIZACIÓN Y MÁQUINA (LLVM & Linker)" {
  direction: right
  style: {
    fill: "#0f172a"
    stroke: "#a855f7"
    stroke-width: 2
    border-radius: 8
  }

  llvm: "Backend (LLVM)\nLLVM IR [.ll / .bc] -> Opt O3" {
    style: { fill: "#1e293b"; stroke: "#c084fc"; font-color: "#ffffff" }
  }

  asm: "Ensamblador [.s]\nCódigo Objeto [.o]" {
    style: { fill: "#1e293b"; stroke: "#ec4899"; font-color: "#ffffff" }
  }

  linker: "Linker (ld / lld)\n+ libstd / Crates" {
    style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#ecfdf5" }
  }

  binario: "EJECUTABLE FINAL\n[ELF / .EXE / WASM]" {
    style: { fill: "#065f46"; stroke: "#10b981"; font-color: "#ffffff"; bold: true }
  }

  llvm -> asm -> linker -> binario
}

# Conexión entre Fila 1 y Fila 2
fila_1.middle -> fila_2.llvm: "Código 100% Seguro"
