direction: down

title: "Arquitectura y Modelos de Ejecución" {
  style: {
    font-size: 24
    bold: true
    font-color: "#ffffff"
  }
}

# --- 1. RUST: COMPILADO NATIVO ---
rust_pipeline: "🦀 RUST: Compilado Nativo (AOT)" {
  direction: right
  style: {
    fill: "#111827"
    stroke: "#f97316"
    stroke-width: 2
    border-radius: 8
  }

  r_src: "📄 main.rs\n(Código)" {
    style: { fill: "#1f2937"; stroke: "#60a5fa"; font-color: "#ffffff" }
  }
  r_comp: "⚙️ rustc + LLVM\n(Build Time O3)" {
    style: { fill: "#451a03"; stroke: "#f97316"; font-color: "#ffedd5" }
  }
  r_bin: "📦 Binario ELF/EXE\n(Código Máquina Puro)" {
    style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#ffffff" }
  }
  r_cpu: "⚡ CPU / Hardware\n(100% Directo Sin GC)" {
    style: { fill: "#78350f"; stroke: "#fbbf24"; font-color: "#ffffff"; bold: true }
  }

  r_src -> r_comp -> r_bin -> r_cpu
}

# --- 2. PYTHON: INTERPRETADO ---
python_pipeline: "🐍 PYTHON: Interpretado en Vivo" {
  direction: right
  style: {
    fill: "#111827"
    stroke: "#38bdf8"
    stroke-width: 2
    border-radius: 8
  }

  p_src: "📄 app.py\n(Código)" {
    style: { fill: "#1f2937"; stroke: "#60a5fa"; font-color: "#ffffff" }
  }
  p_interp: "🔄 Intérprete CPython\n(Eval Loop en Runtime)" {
    style: { fill: "#7f1d1d"; stroke: "#f87171"; font-color: "#fee2e2" }
  }
  p_cpu: "⚡ CPU / Hardware\n(~35% Eficiencia)" {
    style: { fill: "#78350f"; stroke: "#fbbf24"; font-color: "#ffffff" }
  }

  p_src -> p_interp -> p_cpu
}

# --- 3. JAVA: MÁQUINA VIRTUAL ---
java_pipeline: "☕ JAVA: Máquina Virtual / Bytecode" {
  direction: right
  style: {
    fill: "#111827"
    stroke: "#c084fc"
    stroke-width: 2
    border-radius: 8
  }

  j_src: "📄 App.java\n(Código)" {
    style: { fill: "#1f2937"; stroke: "#60a5fa"; font-color: "#ffffff" }
  }
  j_comp: "⚙️ javac\n(Build Time)" {
    style: { fill: "#3b0764"; stroke: "#c084fc"; font-color: "#f3e8ff" }
  }
  j_class: "📑 App.class\n(Bytecode Universal)" {
    style: { fill: "#1e1b4b"; stroke: "#818cf8"; font-color: "#e0e7ff" }
  }
  j_vm: "☕ JVM / JIT Compiler\n(Compila en Caliente + GC)" {
    style: { fill: "#831843"; stroke: "#f472b6"; font-color: "#fdf2f8" }
  }
  j_cpu: "⚡ CPU / Hardware\n(~75% Eficiencia)" {
    style: { fill: "#78350f"; stroke: "#fbbf24"; font-color: "#ffffff" }
  }

  j_src -> j_comp -> j_class -> j_vm -> j_cpu
}
